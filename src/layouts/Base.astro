---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/farbe.css';
import '../styles/components/header.css';
import '../styles/components/footer.css';
import '../styles/print.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, ogLocale, type Lang } from '../i18n/ui';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Pfade dieser Seite in beiden Sprachen, z. B. { de: '/', en: '/en/' } */
  alternate: Record<Lang, string> | null;
  /** Pfad dieser Seite für canonical, falls kein alternate */
  pfad?: string;
  noindex?: boolean;
  ogBild?: string;
  ogBildAlt?: string;
  jsonLd?: object[];
  /** Hero-Auftritt einmal pro Sitzung (nur Startseite) */
  auftritt?: boolean;
  /** Messwerte-Schlüssel für die Footer-Zeile */
  messKey?: string;
  bodyClass?: string;
}

const {
  lang,
  title,
  description,
  alternate,
  pfad,
  noindex = false,
  ogBild = '/og.jpg',
  ogBildAlt,
  jsonLd = [],
  auftritt = false,
  messKey,
  bodyClass,
} = Astro.props;

const t = useT(lang);
const site = Astro.site ?? new URL('https://nico-bodmer.ch');
const eigenerPfad = alternate ? alternate[lang] : (pfad ?? Astro.url.pathname);
const canonical = new URL(eigenerPfad, site).href;
const ogUrl = new URL(ogBild, site).href;
const ogAlt = ogBildAlt ?? (lang === 'de' ? 'Nico Bodmer, Name und Porträt' : 'Nico Bodmer, name and portrait');
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nico Bodmer" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F2F2EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    {
      alternate && (
        <>
          <link rel="alternate" hreflang="de" href={new URL(alternate.de, site).href} />
          <link rel="alternate" hreflang="en" href={new URL(alternate.en, site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternate.de, site).href} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nico Bodmer" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'de' ? 'en' : 'de']} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline define:vars={{ auftritt }}>
      // Vor dem ersten Zeichnen: Design setzen (kein Aufblitzen),
      // JavaScript melden und den Hero-Auftritt einmal pro Sitzung erlauben.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t);
        } catch (e) {}
        if (auftritt) {
          try {
            if (!sessionStorage.getItem('auftritt')) {
              d.setAttribute('data-auftritt', '');
              sessionStorage.setItem('auftritt', '1');
            }
          } catch (e) {}
        }
      })();
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#inhalt">{t('skip')}</a>
    <Header lang={lang} alternate={alternate} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} alternate={alternate} messKey={messKey} />
    <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
