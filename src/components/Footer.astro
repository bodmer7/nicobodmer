---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Icon from './Icon.astro';
import Marke from './Marke.astro';
import { useT, datum, type Lang } from '../i18n/ui';
import { pfad } from '../i18n/routes';
import { person } from '../data/profil';
import { footerMessung } from '../data/messwerte';
interface Props { lang: Lang; alternate: Record<Lang, string> | null; messKey?: string }
const { lang, alternate, messKey } = Astro.props;
const t = useT(lang);
const fm = footerMessung(messKey);
---

<footer class="fuss">
  <div class="wrap fuss__innen">
    <p class="fuss__copy">{t('footer.copy')}</p>
    <ul class="fuss__links">
      <li><a class="mit-icon" href={pfad('lebenslauf', lang)}><Icon name="dokument" />{t('nav.lebenslauf')}</a></li>
      <li><a href={pfad('recht', lang)}>{t('footer.recht')}</a></li>
      <li><a class="mit-icon" href={person.linkedin}><Marke name="linkedin" />LinkedIn</a></li>
      <li><a class="mit-icon" href={person.github}><Marke name="github" />GitHub</a></li>
      <li><LanguageSwitch lang={lang} alternate={alternate} /></li>
      <li><ThemeToggle lang={lang} /></li>
    </ul>
    <div class="fuss__info klein neben">
      <p>{t('footer.cookies')}</p>
      {
        fm && (
          <p data-messung={fm.live ? 'live' : 'lokal'}>
            {t(fm.live ? 'footer.messung' : 'footer.messungLokal', {
              kb: fm.messung.kb,
              lh: `${fm.messung.leistung} / ${fm.messung.barrierefreiheit} / ${fm.messung.bestPractices} / ${fm.messung.seo}`,
              datum: datum(fm.datum, lang),
            })}{' '}
            <span class="sr-only">({t('footer.messungLabel')})</span>
          </p>
        )
      }
      <p>{t('footer.stand')}</p>
    </div>
  </div>
</footer>
