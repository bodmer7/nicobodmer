---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { useT, type Lang } from '../i18n/ui';
import { ankerPfad, pfad } from '../i18n/routes';
interface Props { lang: Lang; alternate: Record<Lang, string> | null }
const { lang, alternate } = Astro.props;
const t = useT(lang);
const links = [
  { href: ankerPfad('arbeiten', lang), text: t('nav.arbeiten') },
  { href: ankerPfad('laufbahn', lang), text: t('nav.laufbahn') },
  { href: pfad('lebenslauf', lang), text: t('nav.lebenslauf') },
  { href: ankerPfad('kontakt', lang), text: t('nav.kontakt') },
];
const aktuell = Astro.url.pathname;
---

<header class="kopf" data-kopf>
  <div class="wrap kopf__innen">
    <a class="kopf__name" href={pfad('start', lang)} aria-label={t('home.label')}>Nico Bodmer</a>
    <nav class="kopf__nav" aria-label={t('nav.label')}>
      <button class="kopf__menu-btn" type="button" aria-expanded="false" aria-controls="hauptmenue" data-menu-btn>
        <span data-menu-text data-open={t('menu.open')} data-close={t('menu.close')}>{t('menu.open')}</span>
      </button>
      <div class="kopf__panel" id="hauptmenue" data-menu-panel>
        <ul class="kopf__links">
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={l.href === aktuell ? 'page' : undefined}>
                  {l.text}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="kopf__werkzeuge">
          <LanguageSwitch lang={lang} alternate={alternate} />
          <ThemeToggle lang={lang} />
        </div>
      </div>
    </nav>
  </div>
</header>
