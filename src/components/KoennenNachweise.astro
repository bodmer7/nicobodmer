---
/**
 * Können als ruhige Übersicht: pro Gruppe eine Tabelle mit Fähigkeit,
 * Niveau und «Eingesetzt in». Ohne JavaScript stehen alle Gruppen
 * untereinander (alle <details> offen). Das Skript macht daraus ab 1024px
 * vertikale Tabs (WAI-ARIA), darunter Akkordeons mit der ersten Gruppe offen.
 */
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { anker, projektPfad } from '../i18n/routes';
import {
  koennen,
  stationen,
  ausbildung,
  person,
  inProjekten,
  niveaus,
  nachweiseVon,
  type NachweisRef,
  type Begriff,
  type KoennenGruppe,
} from '../data/profil';
import { getEntry } from 'astro:content';
import { farbe } from '../data/farben';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const projektTitel = async (id: string) => (await getEntry('projekte', `${lang}/${id}`))?.data.title ?? id;

interface Eintrag {
  text: string;
  href?: string;
  zusatz?: string;
}

const eintrag = async (n: NachweisRef): Promise<Eintrag> => {
  const zusatz = n.zusatz?.[lang];
  switch (n.art) {
    case 'station':
      return { text: stationen.find((x) => x.id === n.id)!.rolle, href: `#lb-${n.id}`, zusatz };
    case 'ausbildung':
      return { text: ausbildung.find((x) => x.id === n.id)!.titel[lang], href: `#lb-${n.id}`, zusatz };
    case 'projekt':
      return { text: await projektTitel(n.id), href: projektPfad(n.id, lang), zusatz };
    case 'laufbahn':
      return { text: n.text[lang], href: `#${anker.laufbahn[lang]}`, zusatz };
    case 'website':
      return { text: t('koennen.website'), zusatz };
  }
};

/** Art der Tabelle: mit Niveau, ohne Niveau (Arbeitsweise) oder Studium */
type Art = 'niveau' | 'ohne' | 'studium';
const art = (g: KoennenGruppe): Art =>
  g.begriffe.some((b) => b.semester) ? 'studium' : g.begriffe.some((b) => b.niveau) ? 'niveau' : 'ohne';

const rang = (b: Begriff) => (b.niveau ? niveaus.indexOf(b.niveau) : 0);

const gruppen = await Promise.all(
  koennen.map(async (g) => ({
    id: g.id,
    titel: g.titel[lang],
    unterzeile: g.unterzeile?.[lang],
    fusszeile: g.fusszeile?.[lang],
    art: art(g),
    zeilen: await Promise.all(
      [...g.begriffe]
        .sort((a, b) => rang(a) - rang(b))
        .map(async (b) => ({
          text: b[lang],
          zweite: b.semester ? t('koennen.semester', { n: b.semester }) : b.niveau ? t(`koennen.niveau.${b.niveau}`) : '',
          nachweise: await Promise.all(nachweiseVon(g, b).map(eintrag)),
        })),
    ),
  })),
);

const spalten: Record<Art, string[]> = {
  niveau: [t('koennen.spalte.faehigkeit'), t('koennen.spalte.niveau'), t('koennen.spalte.eingesetzt')],
  ohne: [t('koennen.spalte.faehigkeit'), t('koennen.spalte.eingesetzt')],
  studium: [t('koennen.spalte.thema'), t('koennen.spalte.stand'), t('koennen.spalte.nachweis')],
};

const alle = [
  ...gruppen.map((g) => ({ ...g, farbe: farbe(g.id), anzahl: g.zeilen.length })),
  {
    id: 'sprachen',
    titel: t('koennen.sprachen'),
    unterzeile: undefined,
    fusszeile: undefined,
    art: 'sprachen' as const,
    zeilen: [],
    farbe: farbe('sprachen'),
    anzahl: person.sprachen.length,
  },
];
const gruppenId = (id: string) => `${anker.koennen[lang]}-${id}`;
---

<div class="koennen" data-koennen>
  <dl class="koennen__legende">
    {
      niveaus.map((n) => (
        <div>
          <dt>{t(`koennen.niveau.${n}`)}:</dt>
          <dd>{t(`koennen.bedeutung.${n}`)}</dd>
        </div>
      ))
    }
  </dl>

  <div class="koennen__ansicht">
    <div class="koennen__tabs" role="tablist" aria-orientation="vertical" aria-label={t('koennen.titel')} data-koennen-tabs hidden>
      {
        alle.map((g, i) => (
          <button
            class="koennen__tab"
            type="button"
            role="tab"
            id={`tab-${gruppenId(g.id)}`}
            aria-controls={gruppenId(g.id)}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-farbe={g.farbe}
            data-tab={g.id}
          >
            <span class="marke">{g.titel}</span>
            <span class="koennen__anzahl ziffern">{g.anzahl}</span>
          </button>
        ))
      }
    </div>

    <div class="koennen__gruppen">
      {
        alle.map((g) => (
          <section class="koennen__gruppe" id={gruppenId(g.id)} data-farbe={g.farbe} data-gruppe={g.id} aria-labelledby={`titel-${gruppenId(g.id)}`}>
            <details open>
              <summary>
                <span class="marke">{g.titel}</span>
                <span class="koennen__anzahl ziffern">{g.anzahl}</span>
              </summary>
              <div class="koennen__panel">
                <h3 class:list={['koennen__titel', { 'mit-icon': g.id === 'studium' }]} id={`titel-${gruppenId(g.id)}`}>
                  {g.id === 'studium' && <Icon name="studium" />}
                  {g.titel}
                </h3>
                {g.unterzeile && <p class="koennen__unterzeile neben">{g.unterzeile}</p>}

                {g.art === 'sprachen' ? (
                  <table class="koennen__tabelle">
                    <thead>
                      <tr>
                        <th scope="col">{t('koennen.spalte.sprache')}</th>
                        <th scope="col">{t('koennen.spalte.niveau')}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {person.sprachen.map((s) => (
                        <tr>
                          <th scope="row">{s.sprache[lang]}</th>
                          <td class="koennen__niveau">
                            <span class="koennen__zelllabel">{t('koennen.spalte.niveau')}: </span>
                            {s.niveau[lang]}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <table class:list={['koennen__tabelle', `koennen__tabelle--${g.art}`]}>
                    <thead>
                      <tr>
                        {spalten[g.art].map((s) => (
                          <th scope="col">{s}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {g.zeilen.map((z) => (
                        <tr>
                          <th scope="row">{z.text}</th>
                          {g.art !== 'ohne' && (
                            <td class="koennen__niveau" data-niveau>
                              <span class="koennen__zelllabel">{spalten[g.art][1]}: </span>
                              {z.zweite}
                            </td>
                          )}
                          <td class="koennen__nachweise">
                            <span class="koennen__zelllabel">{spalten[g.art].at(-1)}: </span>
                            {z.nachweise.map((n, i) => (
                              <span class="koennen__nachweis">{i > 0 && ', '}{n.href ? <a href={n.href}>{n.text}</a> : n.text}{n.zusatz && <span class="neben">{` (${n.zusatz})`}</span>}</span>
                            ))}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}

                {g.fusszeile && <p class="koennen__fusszeile neben">{g.fusszeile}</p>}
                {g.id === 'web' && (
                  <p class="koennen__fusszeile">
                    <span class="label">{t('koennen.inProjekten')}:</span> {inProjekten.join(', ')}
                  </p>
                )}
              </div>
            </details>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script>
  import '../scripts/koennen';
</script>
