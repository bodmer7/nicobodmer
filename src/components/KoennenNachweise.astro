---
/**
 * Können mit Nachweis: Jeder Begriff ist ein Button und öffnet «Eingesetzt in:»
 * mit Links zu Stationen, Ausbildung, Laufbahn und Fallstudien. Begriffe mit
 * eigenen Nachweisen haben ein eigenes Feld, die übrigen teilen sich das Feld
 * der Gruppe. Ohne JavaScript stehen die Nachweise direkt unter den Begriffen.
 */
import { useT, type Lang } from '../i18n/ui';
import { anker, projektPfad } from '../i18n/routes';
import { koennen, stationen, ausbildung, sprachenText, inProjekten, type NachweisRef, type Begriff } from '../data/profil';
import { getEntry } from 'astro:content';
import { farbe } from '../data/farben';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const projektTitel = async (id: string) => (await getEntry('projekte', `${lang}/${id}`))?.data.title ?? id;

interface Eintrag {
  ziel: string;
  text: string;
  unter?: string;
  href?: string;
  zusatz?: string;
}

const eintrag = async (n: NachweisRef): Promise<Eintrag> => {
  const zusatz = n.zusatz?.[lang];
  switch (n.art) {
    case 'station': {
      const s = stationen.find((x) => x.id === n.id)!;
      return { ziel: `station:${n.id}`, text: s.rolle, unter: s.organisation[lang], href: `#lb-${n.id}`, zusatz };
    }
    case 'ausbildung': {
      const a = ausbildung.find((x) => x.id === n.id)!;
      return { ziel: `ausbildung:${n.id}`, text: a.titel[lang], href: `#lb-${n.id}`, zusatz };
    }
    case 'projekt':
      return { ziel: `projekt:${n.id}`, text: await projektTitel(n.id), href: projektPfad(n.id, lang), zusatz };
    case 'laufbahn':
      return { ziel: `laufbahn:${n.ids.join(',')}`, text: n.text[lang], href: `#${anker.laufbahn[lang]}`, zusatz };
    case 'website':
      return { ziel: 'website', text: t('koennen.website'), zusatz };
  }
};

const liste = (refs: NachweisRef[]) => Promise.all(refs.map(eintrag));

const gruppen = await Promise.all(
  koennen.map(async (g) => ({
    ...g,
    liste: await liste(g.nachweise),
    begriffe: await Promise.all(
      g.begriffe.map(async (b: Begriff, i) => ({
        ...b,
        panel: b.nachweise ? `nachweis-${g.id}-${i}` : `nachweis-${g.id}`,
        eigene: b.nachweise ? await liste(b.nachweise) : null,
      })),
    ),
  })),
);
---

<div class="koennen" data-koennen>
  {
    gruppen.map((g) => (
      <div class="koennen__gruppe" id={`${anker.koennen[lang]}-${g.id}`} data-farbe={farbe(g.id)}>
        <h3>{g.titel[lang]}</h3>
        <ul class="begriffe">
          {g.begriffe.map((b) => (
            <li>
              <button class="begriff" type="button" aria-expanded="false" aria-controls={b.panel} data-begriff={g.id}>
                {b[lang]}
              </button>
            </li>
          ))}
        </ul>
        {g.liste.length > 0 && (
          <div class="nachweis" id={`nachweis-${g.id}`} data-nachweis={g.id}>
            <p class="label">{t('koennen.eingesetzt')}</p>
            <ul>
              {g.liste.map((n) => (
                <li data-ziel={n.ziel}>
                  {n.href ? <a href={n.href}>{n.text}</a> : <span>{n.text}</span>}{n.unter && <span class="neben">, {n.unter}</span>}{n.zusatz && <span class="neben"> ({n.zusatz})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
        {g.begriffe
          .filter((b) => b.eigene)
          .map((b) => (
            <div class="nachweis" id={b.panel} data-nachweis={b.panel}>
              <p class="label">
                {b[lang]}. {t('koennen.eingesetzt')}
              </p>
              <ul>
                {b.eigene!.map((n) => (
                  <li data-ziel={n.ziel}>
                    {n.href ? <a href={n.href}>{n.text}</a> : <span>{n.text}</span>}{n.unter && <span class="neben">, {n.unter}</span>}{n.zusatz && <span class="neben"> ({n.zusatz})</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
      </div>
    ))
  }
  <div class="koennen__gruppe" data-farbe="neutral">
    <h3>{t('koennen.sprachen')}</h3>
    <p>{sprachenText(lang)}</p>
  </div>
</div>
<p class="koennen__weitere klein">
  <span class="label">{t('koennen.inProjekten')}:</span>
  {inProjekten.join(', ')}
</p>

<script>
  import '../scripts/koennen';
</script>
