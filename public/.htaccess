# Infomaniak (Apache): eigene 404-Seite, Caching, Komprimierung.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Dateien in /_astro/ tragen einen Hash im Namen und ändern sich nie.
  <FilesMatch "^.*\.(css|js|avif|webp|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

AddType text/vcard .vcf
